{
  "name": "redactly-legal-desktop",
  "version": "0.1.0",
  "description": "Redactly Legal Desktop Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "start:server": "cd ../../engine/python && python -m scripts.web_server --port 8080",
    "start:web": "concurrently \"npm run start:server\" \"npm run dev:web\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "knip": "^5.40.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.0.0"
  }
}
