{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redactly Legal",
  "version": "0.1.0",
  "identifier": "com.redactlylegal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Redactly Legal",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/anonymizer_engine"
    ],
    "resources": [],
    "shortDescription": "GDPR-compliant offline document anonymization",
    "longDescription": "Redactly Legal provides offline, privacy-first PII detection and redaction for legal documents. Supports multiple languages and detection layers.",
    "category": "Utility",
    "copyright": "Elastic License 2.0 (ELv2)",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "enableElevatedUpdateTask": false
      }
    }
  },
  "plugins": {}
}
